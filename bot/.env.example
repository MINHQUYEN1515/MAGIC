# File MẪU — không điền key/token thật ở đây. Copy sang .env rồi điền: cp .env.example .env

# Tạo bot qua @BotFather, dán token vào đây
TELEGRAM_BOT_TOKEN=
# Chat/nhóm nhận tài liệu. Chạy `npm start` rồi gõ /start với bot để biết chat ID
TELEGRAM_CHAT_ID=

# Lịch cào tự động khi chạy `npm start` (cron, mặc định 6 tiếng/lần)
CRON_SCHEDULE=0 */6 * * *
# Số tài liệu mới tối đa mỗi nguồn trong một lần cào
MAX_PER_SOURCE=8
# File PDF lớn hơn sẽ chỉ gửi link (Telegram bot giới hạn 50MB)
MAX_FILE_MB=45
# Số ảnh tối đa mỗi tài liệu
MAX_IMAGES=6
# Nghỉ giữa các request (ms) để không spam nguồn
REQUEST_DELAY_MS=1500

# Tuỳ chọn: có key thì dùng OpenAI (xem ảnh) để phân loại + viết giải thích,
# không có thì phân loại bằng từ khoá. Lấy key tại https://platform.openai.com/api-keys
OPENAI_API_KEY=
# gpt-4o-mini: rẻ, nhanh. o4-mini: suy luận kỹ hơn, chậm và đắt hơn.
OPENAI_MODEL=gpt-4o-mini

# Thông tin liên hệ gắn vào User-Agent (email hoặc URL). Wikimedia yêu cầu,
# để trống dễ bị giới hạn tốc độ khi tải ảnh/PDF
BOT_CONTACT=

# Mức log: debug (chi tiết từng request, từng ảnh) | info | warn | error
LOG_LEVEL=info
